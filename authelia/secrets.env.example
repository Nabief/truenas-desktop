# Secrets Authelia — COPIE ce fichier en authelia/secrets.env puis remplace
# chaque valeur par une chaîne aléatoire d'au moins 32 caractères.
# Génère-les avec :  openssl rand -hex 32
#
# secrets.env est ignoré par git (voir .gitignore). Ne le committe jamais.

AUTHELIA_SESSION_SECRET=REMPLACE_openssl_rand_hex_32
AUTHELIA_STORAGE_ENCRYPTION_KEY=REMPLACE_openssl_rand_hex_32
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=REMPLACE_openssl_rand_hex_32
